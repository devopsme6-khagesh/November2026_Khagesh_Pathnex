#Ansible — Install Apache and Start Service
- name: Install and start Apache
  host: all
  become: yes
  tasks:
	-name: Install apache
	 yum:
  	     name: httpd
	     state: present
	-name: Start apache
	 service: httpd
	 state: present
 	 enabled: yes

